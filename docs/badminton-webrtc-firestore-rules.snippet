# Add inside match /databases/{database}/documents alongside the existing badmintonScoreRooms rule.
# These rules are public because the badminton lobby does not require Firebase Auth.
# Room codes are not secret authorization; deploy App Check and abuse controls before broad use.
match /badmintonScoreRooms/{roomId}/peers/{peerId} {
  allow get, list: if roomId.matches('[a-z0-9_-]{1,40}');
  allow create, update: if roomId.matches('[a-z0-9_-]{1,40}') &&
    peerId.matches('[0-9a-f-]{36}') &&
    request.resource.data.keys().hasOnly(['seenAt']) &&
    request.resource.data.seenAt is number &&
    request.resource.data.seenAt <= request.time.toMillis() + 60000 &&
    request.resource.data.seenAt >= request.time.toMillis() - 60000;
  allow delete: if true;
}
match /badmintonScoreRooms/{roomId}/links/{linkId} {
  allow get, list: if roomId.matches('[a-z0-9_-]{1,40}');
  allow create, update: if roomId.matches('[a-z0-9_-]{1,40}') &&
    request.resource.data.keys().hasOnly(['offer', 'answer']) &&
    request.resource.data.keys().hasAny(['offer', 'answer']) &&
    request.resource.data.size() <= 2;
  allow delete: if false;
}

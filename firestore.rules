rules_version = '2';

// Firestore security rules for ipondnakab.github.io.
//
// Deploy from the Firebase Console (Firestore → Rules → paste + Publish) or via
// the Firebase CLI: `firebase deploy --only firestore:rules`.
//
// Planning Poker is anonymous (no Firebase Auth), so this collection is
// intentionally open — but ONLY this collection, and with lightweight guards.
// Everything else is denied so the database can't be used as free storage or
// have unrelated data read/tampered with. For stronger protection add Firebase
// App Check (blocks requests that don't come from your app).

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Planning Poker rooms ------------------------------------------------
    match /planning-poker/{roomId} {
      // Only allow reasonably-shaped room ids.
      allow read: if roomId.size() > 0 && roomId.size() <= 64;

      // Allow create/update of a room document, with basic shape guards to make
      // abuse harder. `votes` is a user-keyed map that must stay a map; the doc
      // must not grow an unbounded number of top-level fields.
      allow write: if roomId.size() > 0
                   && roomId.size() <= 64
                   && request.resource.data.size() <= 20
                   && (
                     !('votes' in request.resource.data)
                     || request.resource.data.votes is map
                   )
                   && (
                     !('revealed' in request.resource.data)
                     || request.resource.data.revealed is bool
                   )
                   // `history` is a bounded log of past rounds; keep it a
                   // reasonably-sized list so it can't be used as free storage.
                   && (
                     !('history' in request.resource.data)
                     || (request.resource.data.history is list
                         && request.resource.data.history.size() <= 50)
                   );

      // No deleting whole rooms from the client.
      allow delete: if false;
    }

    // --- Mic Link signalling rooms -------------------------------------------
    // Short-lived WebRTC handshake mailboxes. Nothing here is audio: the media
    // goes peer-to-peer. A room holds only an owner token; each connected phone
    // owns one document under senders/ carrying its SDP offer/answer pair and
    // its ICE candidates. The receiver deletes the lot when it hangs up.
    match /mic-link/{roomId} {
      allow read: if roomId.size() > 0 && roomId.size() <= 64;

      allow create, update: if roomId.size() > 0
                            && roomId.size() <= 64
                            && request.resource.data.size() <= 8;

      // Deleting the room is how ending a session invalidates its QR code, so
      // unlike Planning Poker this must be allowed from the client.
      allow delete: if roomId.size() > 0 && roomId.size() <= 64;

      // One document per connected phone.
      //
      // Guarded on roomId, NOT senderId. The receiver watches this collection
      // with onSnapshot, which is a `list`, and during a list the document-id
      // wildcard of the collection being queried is not bound to anything — so
      // a condition like `senderId.size() > 0` evaluates false and silently
      // denies the listener. roomId is a parent path segment and is always
      // bound, for gets and lists alike.
      match /senders/{senderId} {
        allow read, delete: if roomId.size() > 0 && roomId.size() <= 64;

        // SDP blobs are a few KB in practice; the cap stops a room being used
        // as free storage while leaving plenty of headroom.
        allow create, update: if senderId.size() > 0
                              && senderId.size() <= 64
                              && request.resource.data.size() <= 10
                              && (
                                !('offer' in request.resource.data)
                                || (request.resource.data.offer is map
                                    && request.resource.data.offer.sdp is string
                                    && request.resource.data.offer.sdp.size() <= 20000)
                              )
                              && (
                                !('answer' in request.resource.data)
                                || (request.resource.data.answer is map
                                    && request.resource.data.answer.sdp is string
                                    && request.resource.data.answer.sdp.size() <= 20000)
                              );

        // Trickle-ICE candidates, one document each, cleaned up on reconnect
        // and on hang-up.
        match /{side}/{candidateId} {
          allow read, delete: if side == 'senderCandidates'
                              || side == 'receiverCandidates';

          allow create: if (side == 'senderCandidates'
                            || side == 'receiverCandidates')
                        && request.resource.data.size() <= 6
                        && request.resource.data.candidate is string
                        && request.resource.data.candidate.size() <= 1000;
        }
      }
    }

    // --- Everything else: locked --------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

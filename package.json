{
  "name": "ipondnakab",
  "version": "3.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "yarn lint && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && yarn format:check",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "prepare": "husky install",
    "test:architecture": "vitest run src/shared/config/architecture.test.ts",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@nextui-org/react": "^2.2.9",
    "@nextui-org/theme": "^2.1.17",
    "@react-three/drei": "^9",
    "@react-three/fiber": "^8",
    "@tsparticles/engine": "^3.0.2",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.0.2",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.10",
    "firebase": "^12.12.1",
    "framer-motion": "^10.16.16",
    "gsap": "^3.15.0",
    "i18next": "^26.3.4",
    "next": "14.2.21",
    "next-themes": "^0.2.1",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.49.1",
    "react-i18next": "^17.0.8",
    "react-icons": "^4.12.0",
    "three": "^0.182.0",
    "zod": "3.25.76"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/semver": "^7.8.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.5",
    "archunit": "2.5.5",
    "autoprefixer": "^10.0.1",
    "husky": "^8.0.0",
    "jsdom": "^26",
    "lint-staged": "^15.2.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "postcss": "^8",
    "semver": "^7.8.5",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,scss,md,mdx,html,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
